{"hook": [{"i": 0, "t0": 0.25, "t1": 0.997, "text": "رقمُ علي..."}, {"i": 1, "t0": 1.347, "t1": 2.419, "text": "صفرُ سنوات."}, {"i": 2, "t0": 2.769, "t1": 3.745, "text": "صفرُ أيّام."}, {"i": 3, "t0": 4.095, "t1": 4.949, "text": "ساعتان."}], "main": [{"i": 0, "t0": 5.949, "t1": 7.407, "text": "صباحَ يومِ ثلاثاء."}, {"i": 1, "t0": 7.707, "t1": 8.36, "text": "تستيقظ..."}, {"i": 2, "t0": 8.86, "t1": 10.893, "text": "وفوقَ رأسِ أمِّك شيءٌ يطفو."}, {"i": 3, "t0": 11.193, "t1": 12.509, "text": "أرقامٌ متوهِّجة."}, {"i": 4, "t0": 12.809, "t1": 14.549, "text": "واحدٌ وثلاثون عامًا."}, {"i": 5, "t0": 14.849, "t1": 15.781, "text": "أربعةُ أشهر."}, {"i": 6, "t0": 16.081, "t1": 17.076, "text": "ستّةُ أيّام."}, {"i": 7, "t0": 17.376, "t1": 19.105, "text": "وهي تَعُدُّ تنازليًّا."}, {"i": 8, "t0": 19.755, "t1": 23.667, "text": "على الفطور، أخوك الصغير لديه اثنان وسبعون عامًا."}, {"i": 9, "t0": 23.967, "t1": 25.147, "text": "والقطّةُ لديها..."}, {"i": 10, "t0": 25.647, "t1": 26.018, "text": "تسعة."}, {"i": 11, "t0": 26.668, "t1": 27.765, "text": "تخرجُ من البيت."}, {"i": 12, "t0": 28.065, "t1": 29.328, "text": "الكلُّ لديه رقم."}, {"i": 13, "t0": 29.628, "t1": 30.701, "text": "سائقُ الحافلة."}, {"i": 14, "t0": 31.001, "t1": 31.892, "text": "الخبّاز."}, {"i": 15, "t0": 32.192, "t1": 33.289, "text": "طفلٌ في عربته..."}, {"i": 16, "t0": 33.789, "t1": 35.584, "text": "أربعةٌ وثمانون عامًا."}, {"i": 17, "t0": 36.234, "t1": 39.228, "text": "فماذا لو استطعتَ أن ترى كم بقيَ لكلِّ شخص؟"}, {"i": 18, "t0": 39.878, "t1": 43.915, "text": "متوسّطُ عمرِ الإنسان اليوم حوالي ثلاثةٍ وسبعين عامًا."}, {"i": 19, "t0": 44.215, "t1": 47.671, "text": "أي ما يقاربُ ستّةً وعشرين ألفًا وثمانمئةِ يوم."}, {"i": 20, "t0": 47.971, "t1": 48.841, "text": "ومعظمُها..."}, {"i": 21, "t0": 49.341, "t1": 50.629, "text": "لا نَعُدُّها أبدًا."}, {"i": 22, "t0": 51.279, "t1": 52.555, "text": "اليومُ الأوّلُ غريب."}, {"i": 23, "t0": 52.855, "t1": 54.213, "text": "واليومُ الثاني أسوأ."}, {"i": 24, "t0": 54.863, "t1": 58.831, "text": "على مقعدٍ في الحديقة، رجلٌ عجوز يُطعِمُ الحمام."}, {"i": 25, "t0": 59.131, "t1": 59.599, "text": "رقمُه..."}, {"i": 26, "t0": 60.099, "t1": 61.168, "text": "ستُّ دقائق."}, {"i": 27, "t0": 61.868, "t1": 62.52, "text": "تتجمّد."}, {"i": 28, "t0": 62.82, "t1": 64.633, "text": "يمكنُك أن تمشيَ بعيدًا."}, {"i": 29, "t0": 64.933, "t1": 66.552, "text": "لن يعرفَ أحدٌ أبدًا."}, {"i": 30, "t0": 66.852, "t1": 68.516, "text": "لكنّك تجلسُ بجانبه."}, {"i": 31, "t0": 69.166, "t1": 70.403, "text": "اسمُه الحاجّ سالم."}, {"i": 32, "t0": 70.703, "t1": 72.906, "text": "يحكي لك عن زوجته، فاطمة."}, {"i": 33, "t0": 73.206, "t1": 75.189, "text": "خمسون عامًا من الفطور معًا."}, {"i": 34, "t0": 75.489, "t1": 76.819, "text": "كانت تحرقُ الخبز..."}, {"i": 35, "t0": 77.319, "t1": 78.124, "text": "في كلِّ مرّة."}, {"i": 36, "t0": 78.424, "t1": 78.978, "text": "يضحك."}, {"i": 37, "t0": 79.628, "t1": 80.3, "text": "ثمّ يصمت."}, {"i": 38, "t0": 80.6, "t1": 82.29, "text": "ويصلُ الرقمُ إلى الصفر."}, {"i": 39, "t0": 83.19, "t1": 84.17, "text": "وهو يبتسم."}, {"i": 40, "t0": 84.47, "t1": 85.568, "text": "وتفهمُ شيئًا."}, {"i": 41, "t0": 85.868, "t1": 87.575, "text": "لا يمكنُك إيقافُ الساعة."}, {"i": 42, "t0": 87.875, "t1": 92.065, "text": "لكن يمكنُك أن تختارَ من يجلسُ بجانبِ أحدِهم حين تتوقّف."}, {"i": 43, "t0": 92.715, "t1": 99.931, "text": "منذ عامِ ألفٍ وتسعمئةٍ وثمانيةٍ وثلاثين، تتابعُ جامعةُ هارفارد مئاتِ الأشخاص طوالَ حياتِهم."}, {"i": 44, "t0": 100.231, "t1": 100.231, "text": "إنّها من أطولِ الدراسات عن حياةِ البالغين على الإطلاق."}, {"i": 45, "t0": 100.231, "t1": 104.036, "text": "أقوى مؤشّرٍ على حياةٍ طويلةٍ وصحّيّة لم يكن المال."}, {"i": 46, "t0": 104.336, "t1": 105.502, "text": "ولم يكن الشهرة."}, {"i": 47, "t0": 105.802, "t1": 107.255, "text": "بل العلاقاتُ القريبة."}, {"i": 48, "t0": 107.905, "t1": 109.373, "text": "ثمّ يأتي يومُ الجمعة."}, {"i": 49, "t0": 109.673, "t1": 114.06, "text": "صديقُك المقرّب علي يركضُ نحوك، يضحكُ على مقطعٍ ما."}, {"i": 50, "t0": 114.36, "t1": 115.318, "text": "ترفعُ عينيك."}, {"i": 51, "t0": 115.618, "t1": 116.365, "text": "رقمُ علي..."}, {"i": 52, "t0": 116.865, "t1": 117.937, "text": "صفرُ سنوات."}, {"i": 53, "t0": 118.237, "t1": 119.213, "text": "صفرُ أيّام."}, {"i": 54, "t0": 119.513, "t1": 120.367, "text": "ساعتان."}, {"i": 55, "t0": 121.067, "t1": 122.032, "text": "قلبُك يسقط."}, {"i": 56, "t0": 122.632, "t1": 123.379, "text": "لا تخبره."}, {"i": 57, "t0": 123.679, "t1": 123.679, "text": "كيف لك أن تخبره؟"}, {"i": 58, "t0": 123.679, "t1": 124.519, "text": "تُلغي خططَه."}, {"i": 59, "t0": 124.819, "t1": 127.354, "text": "تمشي معه إلى البيت من الطريقِ الأطول."}, {"i": 60, "t0": 127.654, "t1": 127.654, "text": "يظنُّ أنّك فقدتَ عقلك."}, {"i": 61, "t0": 127.654, "t1": 129.126, "text": "بقيت ستُّ دقائق."}, {"i": 62, "t0": 129.426, "t1": 130.411, "text": "ممرُّ المشاة."}, {"i": 63, "t0": 130.711, "t1": 132.379, "text": "الإشارةُ تصبحُ خضراء."}, {"i": 64, "t0": 132.679, "t1": 134.262, "text": "يخطو علي إلى الأمام..."}, {"i": 65, "t0": 134.762, "t1": 136.061, "text": "فتُمسِكُ بسترته."}, {"i": 66, "t0": 136.361, "t1": 138.736, "text": "شاحنةٌ تتجاوزُ الإشارةَ الحمراء."}, {"i": 67, "t0": 139.036, "t1": 140.552, "text": "على بُعدِ سنتيمترات."}, {"i": 68, "t0": 141.152, "t1": 141.52, "text": "صمت."}, {"i": 69, "t0": 142.32, "t1": 143.277, "text": "ترفعُ عينيك."}, {"i": 70, "t0": 143.577, "t1": 144.749, "text": "رقمُ علي يدور..."}, {"i": 71, "t0": 145.249, "t1": 146.329, "text": "ثمّ يتوقّف."}, {"i": 72, "t0": 146.629, "t1": 148.296, "text": "واحدٌ وستّون عامًا."}, {"i": 73, "t0": 148.896, "t1": 149.926, "text": "إنّه يرتجف."}, {"i": 74, "t0": 150.226, "t1": 150.914, "text": "كيف عرفت؟"}, {"i": 75, "t0": 151.214, "t1": 152.018, "text": "لا تُجيب."}, {"i": 76, "t0": 152.318, "t1": 153.359, "text": "فقط تعانقُه."}, {"i": 77, "t0": 154.009, "t1": 158.266, "text": "حوادثُ الطرق تقتلُ حوالي مليونٍ ومئتي ألفِ شخصٍ كلَّ عام."}, {"i": 78, "t0": 158.566, "t1": 160.417, "text": "أكثرُ من اثنين كلَّ دقيقة."}, {"i": 79, "t0": 160.717, "t1": 166.717, "text": "وهي السببُ الأوّلُ للوفاة بين من تتراوحُ أعمارُهم بين خمسةٍ وتسعةٍ وعشرين عامًا."}, {"i": 80, "t0": 167.017, "t1": 169.665, "text": "إذن، الأرقامُ يمكنُ أن تتغيّر."}, {"i": 81, "t0": 170.315, "t1": 172.851, "text": "في تلك الليلة، تقفُ أمامَ المرآة."}, {"i": 82, "t0": 173.151, "t1": 175.521, "text": "لأوّلِ مرّة، تبحثُ عن رقمِك."}, {"i": 83, "t0": 175.821, "t1": 176.664, "text": "فوقَ رأسِك..."}, {"i": 84, "t0": 177.164, "t1": 177.675, "text": "لا شيء."}, {"i": 85, "t0": 178.275, "t1": 179.004, "text": "لا رقم."}, {"i": 86, "t0": 179.504, "t1": 180.212, "text": "أنت فقط."}, {"i": 87, "t0": 180.512, "t1": 181.617, "text": "ترى وقتَ الجميع..."}, {"i": 88, "t0": 182.117, "t1": 182.971, "text": "إلّا وقتَك."}, {"i": 89, "t0": 183.271, "t1": 183.271, "text": "ربّما هذا هو المقصود."}, {"i": 90, "t0": 183.271, "t1": 183.271, "text": "لا أحدَ يرى ساعتَه."}, {"i": 91, "t0": 183.271, "t1": 184.825, "text": "فكلُّ ما يمكنُك فعلُه..."}, {"i": 92, "t0": 185.325, "t1": 186.263, "text": "ألّا تُضيّعَه."}, {"i": 93, "t0": 186.913, "t1": 187.832, "text": "تراسلُ أمَّك."}, {"i": 94, "t0": 188.132, "t1": 188.649, "text": "أحبّك."}, {"i": 95, "t0": 188.949, "t1": 190.569, "text": "تردُّ بثلاثةِ قلوب."}, {"i": 96, "t0": 190.869, "t1": 192.609, "text": "واحدٌ وثلاثون عامًا."}, {"i": 97, "t0": 192.909, "t1": 195.067, "text": "وتنوي أن تملأَ كلَّ واحدٍ منها."}, {"i": 98, "t0": 195.717, "t1": 197.288, "text": "إذن، ما الحقيقي؟"}, {"i": 99, "t0": 197.588, "t1": 197.588, "text": "لا أحدَ يستطيعُ رؤيةَ عدٍّ تنازلي."}, {"i": 100, "t0": 197.588, "t1": 201.01, "text": "متوسّطُ العمر مجرّدُ معدّل، وليس وعدًا."}, {"i": 101, "t0": 201.31, "t1": 207.112, "text": "ما يُقصّرُ معظمَ الأعمار بطيء: التدخين، والجلوسُ الطويل، والوحدة."}, {"i": 102, "t0": 207.412, "t1": 209.861, "text": "وما يُطيلُها يكادُ يكونُ مملًّا..."}, {"i": 103, "t0": 210.361, "t1": 213.695, "text": "النوم، والحركة، والناسُ الذين تحبّهم."}, {"i": 104, "t0": 214.345, "t1": 216.674, "text": "ماذا ستفعلُ لو رأيتَ رقمَك أنت؟"}, {"i": 105, "t0": 216.974, "t1": 219.081, "text": "وماذا لو استطعتَ إيقافَ الزمن؟"}, {"i": 106, "t0": 219.381, "t1": 224.494, "text": "أخبرنا في التعليقات، وقل لنا أيَّ قوّةٍ نعيشُها في الحلقةِ القادمة."}, {"i": 107, "t0": 224.794, "t1": 227.426, "text": "اضغط لايك، واشترك للمزيد."}]}