{"hook": [{"i": 0, "t0": 0.0, "t1": 0.802125, "text": "رقمُ علي..."}, {"i": 1, "t0": 1.52492, "t1": 2.57754, "text": "صفرُ سنوات."}, {"i": 2, "t0": 3.18458, "t1": 4.07346, "text": "صفرُ أيّام."}, {"i": 3, "t0": 4.78275, "t1": 5.49483, "text": "ساعتان."}, {"i": 4, "t0": 6.73858, "t1": 7.86612, "text": "لنعُد إلى البداية..."}], "main": [{"i": 0, "t0": 8.78608, "t1": 10.0019, "text": "صباحَ يومِ ثلاثاء."}, {"i": 1, "t0": 10.6585, "t1": 11.3593, "text": "تستيقظ..."}, {"i": 2, "t0": 11.9938, "t1": 13.8699, "text": "وفوقَ رأسِ أمِّك شيءٌ يطفو."}, {"i": 3, "t0": 14.3995, "t1": 15.8235, "text": "أرقامٌ متوهِّجة."}, {"i": 4, "t0": 16.5165, "t1": 18.0696, "text": "واحدٌ وثلاثون عامًا."}, {"i": 5, "t0": 18.6077, "t1": 19.4813, "text": "أربعةُ أشهر."}, {"i": 6, "t0": 20.0537, "t1": 20.8496, "text": "ستّةُ أيّام."}, {"i": 7, "t0": 21.5997, "t1": 23.1966, "text": "وهي تَعُدُّ تنازليًّا."}, {"i": 8, "t0": 24.0715, "t1": 28.1462, "text": "على الفطور، أخوك الصغير لديه اثنان وسبعون عامًا."}, {"i": 9, "t0": 28.7633, "t1": 29.8502, "text": "والقطّةُ لديها..."}, {"i": 10, "t0": 30.4249, "t1": 30.7395, "text": "تسعة."}, {"i": 11, "t0": 31.6945, "t1": 32.5165, "text": "تخرجُ من البيت."}, {"i": 12, "t0": 33.1347, "t1": 34.257, "text": "الكلُّ لديه رقم."}, {"i": 13, "t0": 34.8385, "t1": 35.7503, "text": "سائقُ الحافلة."}, {"i": 14, "t0": 36.2868, "t1": 36.9401, "text": "الخبّاز."}, {"i": 15, "t0": 37.453, "t1": 38.4137, "text": "طفلٌ في عربته..."}, {"i": 16, "t0": 38.9792, "t1": 40.5208, "text": "أربعةٌ وثمانون عامًا."}, {"i": 17, "t0": 41.1346, "t1": 44.7675, "text": "فماذا لو استطعتَ أن ترى كم بقيَ لكلِّ شخص؟"}, {"i": 18, "t0": 45.9759, "t1": 49.9589, "text": "متوسّطُ عمرِ الإنسان اليوم حوالي ثلاثةٍ وسبعين عامًا."}, {"i": 19, "t0": 50.4956, "t1": 54.2615, "text": "أي ما يقاربُ ستّةً وعشرين ألفًا وثمانمئةِ يوم."}, {"i": 20, "t0": 54.8302, "t1": 55.57, "text": "ومعظمُها..."}, {"i": 21, "t0": 56.0319, "t1": 56.9708, "text": "لا نَعُدُّها أبدًا."}, {"i": 22, "t0": 58.1736, "t1": 59.8313, "text": "اليومُ الأوّلُ غريب."}, {"i": 23, "t0": 60.4932, "t1": 62.3363, "text": "واليومُ الثاني أسوأ."}, {"i": 24, "t0": 63.1642, "t1": 67.2683, "text": "على مقعدٍ في الحديقة، رجلٌ عجوز يُطعِمُ الحمام."}, {"i": 25, "t0": 67.8575, "t1": 68.4807, "text": "رقمُه..."}, {"i": 26, "t0": 68.753, "t1": 69.8027, "text": "ستُّ دقائق."}, {"i": 27, "t0": 70.6022, "t1": 71.1088, "text": "تتجمّد."}, {"i": 28, "t0": 71.4692, "t1": 73.2025, "text": "يمكنُك أن تمشيَ بعيدًا."}, {"i": 29, "t0": 73.6975, "t1": 74.9875, "text": "لن يعرفَ أحدٌ أبدًا."}, {"i": 30, "t0": 75.8617, "t1": 77.5991, "text": "لكنّك تجلسُ بجانبه."}, {"i": 31, "t0": 78.5272, "t1": 80.0918, "text": "اسمُه الحاجّ سالم."}, {"i": 32, "t0": 80.7134, "t1": 82.4822, "text": "يحكي لك عن زوجته، فاطمة."}, {"i": 33, "t0": 83.0175, "t1": 84.9564, "text": "خمسون عامًا من الفطور معًا."}, {"i": 34, "t0": 85.6457, "t1": 86.9635, "text": "كانت تحرقُ الخبز..."}, {"i": 35, "t0": 87.4943, "t1": 88.328, "text": "في كلِّ مرّة."}, {"i": 36, "t0": 89.3143, "t1": 89.7558, "text": "يضحك."}, {"i": 37, "t0": 90.8276, "t1": 91.4666, "text": "ثمّ يصمت."}, {"i": 38, "t0": 92.2873, "t1": 93.7475, "text": "ويصلُ الرقمُ إلى الصفر."}, {"i": 39, "t0": 94.7293, "t1": 95.4783, "text": "وهو يبتسم."}, {"i": 40, "t0": 96.2463, "t1": 97.4684, "text": "وتفهمُ شيئًا."}, {"i": 41, "t0": 98.3553, "t1": 99.8577, "text": "لا يمكنُك إيقافُ الساعة."}, {"i": 42, "t0": 100.904, "t1": 105.672, "text": "لكن يمكنُك أن تختارَ من يجلسُ بجانبِ أحدِهم حين تتوقّف."}, {"i": 43, "t0": 107.446, "t1": 114.319, "text": "منذ عامِ ألفٍ وتسعمئةٍ وثمانيةٍ وثلاثين، تتابعُ جامعةُ هارفارد مئاتِ الأشخاص طوالَ حياتِهم."}, {"i": 44, "t0": 114.319, "t1": 114.319, "text": "إنّها من أطولِ الدراسات عن حياةِ البالغين على الإطلاق."}, {"i": 45, "t0": 115.255, "t1": 119.657, "text": "أقوى مؤشّرٍ على حياةٍ طويلةٍ وصحّيّة لم يكن المال."}, {"i": 46, "t0": 120.215, "t1": 121.089, "text": "ولم يكن الشهرة."}, {"i": 47, "t0": 121.675, "t1": 123.329, "text": "بل العلاقاتُ القريبة."}, {"i": 48, "t0": 123.876, "t1": 125.348, "text": "ثمّ يأتي يومُ الجمعة."}, {"i": 49, "t0": 125.865, "t1": 130.245, "text": "صديقُك المقرّب علي يركضُ نحوك، يضحكُ على مقطعٍ ما."}, {"i": 50, "t0": 130.977, "t1": 131.691, "text": "ترفعُ عينيك."}, {"i": 51, "t0": 132.463, "t1": 133.245, "text": "رقمُ علي..."}, {"i": 52, "t0": 134.28, "t1": 134.97, "text": "صفرُ سنوات."}, {"i": 53, "t0": 135.665, "t1": 136.354, "text": "صفرُ أيّام."}, {"i": 54, "t0": 137.168, "t1": 137.675, "text": "ساعتان."}, {"i": 55, "t0": 138.604, "t1": 139.533, "text": "قلبُك يسقط."}, {"i": 56, "t0": 140.257, "t1": 140.766, "text": "لا تخبره."}, {"i": 57, "t0": 140.766, "t1": 140.766, "text": "كيف لك أن تخبره؟"}, {"i": 58, "t0": 141.465, "t1": 142.247, "text": "تُلغي خططَه."}, {"i": 59, "t0": 142.938, "t1": 145.545, "text": "تمشي معه إلى البيت من الطريقِ الأطول."}, {"i": 60, "t0": 145.545, "t1": 145.545, "text": "يظنُّ أنّك فقدتَ عقلك."}, {"i": 61, "t0": 146.085, "t1": 147.965, "text": "بقيت ستُّ دقائق."}, {"i": 62, "t0": 148.748, "t1": 149.452, "text": "ممرُّ المشاة."}, {"i": 63, "t0": 150.178, "t1": 151.547, "text": "الإشارةُ تصبحُ خضراء."}, {"i": 64, "t0": 152.354, "t1": 153.716, "text": "يخطو علي إلى الأمام..."}, {"i": 65, "t0": 154.541, "t1": 155.649, "text": "فتُمسِكُ بسترته."}, {"i": 66, "t0": 156.36, "t1": 158.714, "text": "شاحنةٌ تتجاوزُ الإشارةَ الحمراء."}, {"i": 67, "t0": 159.34, "t1": 161.332, "text": "على بُعدِ سنتيمترات."}, {"i": 68, "t0": 162.027, "t1": 162.39, "text": "صمت."}, {"i": 69, "t0": 163.183, "t1": 163.893, "text": "ترفعُ عينيك."}, {"i": 70, "t0": 164.621, "t1": 165.859, "text": "رقمُ علي يدور..."}, {"i": 71, "t0": 166.756, "t1": 167.769, "text": "ثمّ يتوقّف."}, {"i": 72, "t0": 168.541, "t1": 170.464, "text": "واحدٌ وستّون عامًا."}, {"i": 73, "t0": 171.359, "t1": 172.139, "text": "إنّه يرتجف."}, {"i": 74, "t0": 172.986, "t1": 173.634, "text": "كيف عرفت؟"}, {"i": 75, "t0": 174.561, "t1": 175.086, "text": "لا تُجيب."}, {"i": 76, "t0": 175.752, "t1": 176.954, "text": "فقط تعانقُه."}, {"i": 77, "t0": 177.938, "t1": 182.56, "text": "حوادثُ الطرق تقتلُ حوالي مليونٍ ومئتي ألفِ شخصٍ كلَّ عام."}, {"i": 78, "t0": 183.324, "t1": 184.946, "text": "أكثرُ من اثنين كلَّ دقيقة."}, {"i": 79, "t0": 185.349, "t1": 192.725, "text": "وهي السببُ الأوّلُ للوفاة بين من تتراوحُ أعمارُهم بين خمسةٍ وتسعةٍ وعشرين عامًا."}, {"i": 80, "t0": 193.446, "t1": 195.401, "text": "إذن، الأرقامُ يمكنُ أن تتغيّر."}, {"i": 81, "t0": 196.208, "t1": 198.352, "text": "في تلك الليلة، تقفُ أمامَ المرآة."}, {"i": 82, "t0": 198.82, "t1": 200.977, "text": "لأوّلِ مرّة، تبحثُ عن رقمِك."}, {"i": 83, "t0": 201.82, "t1": 202.51, "text": "فوقَ رأسِك..."}, {"i": 84, "t0": 203.388, "t1": 203.825, "text": "لا شيء."}, {"i": 85, "t0": 204.716, "t1": 205.13, "text": "لا رقم."}, {"i": 86, "t0": 206.036, "t1": 206.865, "text": "أنت فقط."}, {"i": 87, "t0": 207.585, "t1": 208.409, "text": "ترى وقتَ الجميع..."}, {"i": 88, "t0": 208.72, "t1": 209.927, "text": "إلّا وقتَك."}, {"i": 89, "t0": 209.927, "t1": 209.927, "text": "ربّما هذا هو المقصود."}, {"i": 90, "t0": 209.927, "t1": 209.927, "text": "لا أحدَ يرى ساعتَه."}, {"i": 91, "t0": 210.521, "t1": 211.906, "text": "فكلُّ ما يمكنُك فعلُه..."}, {"i": 92, "t0": 212.751, "t1": 213.712, "text": "ألّا تُضيّعَه."}, {"i": 93, "t0": 214.27, "t1": 215.206, "text": "تراسلُ أمَّك."}, {"i": 94, "t0": 215.864, "t1": 216.477, "text": "أحبّك."}, {"i": 95, "t0": 217.149, "t1": 218.338, "text": "تردُّ بثلاثةِ قلوب."}, {"i": 96, "t0": 219.17, "t1": 220.51, "text": "واحدٌ وثلاثون عامًا."}, {"i": 97, "t0": 220.933, "t1": 223.301, "text": "وتنوي أن تملأَ كلَّ واحدٍ منها."}, {"i": 98, "t0": 224.216, "t1": 225.769, "text": "إذن، ما الحقيقي؟"}, {"i": 99, "t0": 225.769, "t1": 225.769, "text": "لا أحدَ يستطيعُ رؤيةَ عدٍّ تنازلي."}, {"i": 100, "t0": 226.556, "t1": 229.998, "text": "متوسّطُ العمر مجرّدُ معدّل، وليس وعدًا."}, {"i": 101, "t0": 230.605, "t1": 236.048, "text": "ما يُقصّرُ معظمَ الأعمار بطيء: التدخين، والجلوسُ الطويل، والوحدة."}, {"i": 102, "t0": 236.957, "t1": 240.278, "text": "وما يُطيلُها يكادُ يكونُ مملًّا..."}, {"i": 103, "t0": 240.76, "t1": 244.09, "text": "النوم، والحركة، والناسُ الذين تحبّهم."}, {"i": 104, "t0": 244.36, "t1": 246.584, "text": "ماذا ستفعلُ لو رأيتَ رقمَك أنت؟"}, {"i": 105, "t0": 247.452, "t1": 249.972, "text": "وماذا لو استطعتَ إيقافَ الزمن؟"}, {"i": 106, "t0": 250.268, "t1": 254.424, "text": "أخبرنا في التعليقات، وقل لنا أيَّ قوّةٍ نعيشُها في الحلقةِ القادمة."}, {"i": 107, "t0": 255.321, "t1": 257.049, "text": "اضغط لايك، واشترك للمزيد."}]}