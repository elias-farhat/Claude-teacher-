[
{
"i": 0,
"t0": 0.4,
"t1": 1.986,
"text": "صباحَ يومِ ثلاثاء."
},
{
"i": 1,
"t0": 2.406,
"t1": 3.123,
"text": "تستيقظ..."
},
{
"i": 2,
"t0": 3.723,
"t1": 5.953,
"text": "وفوقَ رأسِ أمِّك شيءٌ يطفو."
},
{
"i": 3,
"t0": 6.373,
"t1": 7.808,
"text": "أرقامٌ متوهِّجة."
},
{
"i": 4,
"t0": 8.228,
"t1": 10.14,
"text": "واحدٌ وثلاثون عامًا."
},
{
"i": 5,
"t0": 10.56,
"t1": 11.589,
"text": "أربعةُ أشهر."
},
{
"i": 6,
"t0": 12.009,
"t1": 13.098,
"text": "ستّةُ أيّام."
},
{
"i": 7,
"t0": 13.518,
"t1": 15.406,
"text": "وهي تَعُدُّ تنازليًّا."
},
{
"i": 8,
"t0": 16.356,
"t1": 20.652,
"text": "على الفطور، أخوك الصغير لديه اثنان وسبعون عامًا."
},
{
"i": 9,
"t0": 21.072,
"t1": 22.35,
"text": "والقطّةُ لديها..."
},
{
"i": 10,
"t0": 22.95,
"t1": 23.352,
"text": "تسعة."
},
{
"i": 11,
"t0": 24.302,
"t1": 25.494,
"text": "تخرجُ من البيت."
},
{
"i": 12,
"t0": 25.914,
"t1": 27.303,
"text": "الكلُّ لديه رقم."
},
{
"i": 13,
"t0": 27.723,
"t1": 28.891,
"text": "سائقُ الحافلة."
},
{
"i": 14,
"t0": 29.311,
"t1": 30.27,
"text": "الخبّاز."
},
{
"i": 15,
"t0": 30.69,
"t1": 31.891,
"text": "طفلٌ في عربته..."
},
{
"i": 16,
"t0": 32.491,
"t1": 34.448,
"text": "أربعةٌ وثمانون عامًا."
},
{
"i": 17,
"t0": 35.398,
"t1": 38.678,
"text": "فماذا لو استطعتَ أن ترى كم بقيَ لكلِّ شخص؟"
},
{
"i": 18,
"t0": 39.628,
"t1": 44.07,
"text": "متوسّطُ عمرِ الإنسان اليوم حوالي ثلاثةٍ وسبعين عامًا."
},
{
"i": 19,
"t0": 44.49,
"t1": 48.299,
"text": "أي ما يقاربُ ستّةً وعشرين ألفًا وثمانمئةِ يوم."
},
{
"i": 20,
"t0": 48.719,
"t1": 49.669,
"text": "ومعظمُها..."
},
{
"i": 21,
"t0": 50.269,
"t1": 51.682,
"text": "لا نَعُدُّها أبدًا."
},
{
"i": 22,
"t0": 52.632,
"t1": 54.034,
"text": "اليومُ الأوّلُ غريب."
},
{
"i": 23,
"t0": 54.454,
"t1": 55.933,
"text": "واليومُ الثاني أسوأ."
},
{
"i": 24,
"t0": 56.883,
"t1": 61.237,
"text": "على مقعدٍ في الحديقة، رجلٌ عجوز يُطعِمُ الحمام."
},
{
"i": 25,
"t0": 61.657,
"t1": 62.16,
"text": "رقمُه..."
},
{
"i": 26,
"t0": 62.76,
"t1": 63.944,
"text": "ستُّ دقائق."
},
{
"i": 27,
"t0": 64.944,
"t1": 65.653,
"text": "تتجمّد."
},
{
"i": 28,
"t0": 66.073,
"t1": 68.05,
"text": "يمكنُك أن تمشيَ بعيدًا."
},
{
"i": 29,
"t0": 68.47,
"t1": 70.233,
"text": "لن يعرفَ أحدٌ أبدًا."
},
{
"i": 30,
"t0": 70.653,
"t1": 72.467,
"text": "لكنّك تجلسُ بجانبه."
},
{
"i": 31,
"t0": 73.417,
"t1": 74.755,
"text": "اسمُه الحاجّ سالم."
},
{
"i": 32,
"t0": 75.175,
"t1": 77.595,
"text": "يحكي لك عن زوجته، فاطمة."
},
{
"i": 33,
"t0": 78.015,
"t1": 80.189,
"text": "خمسون عامًا من الفطور معًا."
},
{
"i": 34,
"t0": 80.609,
"t1": 82.067,
"text": "كانت تحرقُ الخبز..."
},
{
"i": 35,
"t0": 82.667,
"t1": 83.546,
"text": "في كلِّ مرّة."
},
{
"i": 36,
"t0": 83.966,
"t1": 84.57,
"text": "يضحك."
},
{
"i": 37,
"t0": 85.52,
"t1": 86.249,
"text": "ثمّ يصمت."
},
{
"i": 38,
"t0": 86.669,
"t1": 88.519,
"text": "ويصلُ الرقمُ إلى الصفر."
},
{
"i": 39,
"t0": 89.719,
"t1": 90.782,
"text": "وهو يبتسم."
},
{
"i": 40,
"t0": 91.202,
"t1": 92.396,
"text": "وتفهمُ شيئًا."
},
{
"i": 41,
"t0": 92.816,
"t1": 94.685,
"text": "لا يمكنُك إيقافُ الساعة."
},
{
"i": 42,
"t0": 95.105,
"t1": 99.698,
"text": "لكن يمكنُك أن تختارَ من يجلسُ بجانبِ أحدِهم حين تتوقّف."
},
{
"i": 43,
"t0": 100.648,
"t1": 108.578,
"text": "منذ عامِ ألفٍ وتسعمئةٍ وثمانيةٍ وثلاثين، تتابعُ جامعةُ هارفارد مئاتِ الأشخاص طوالَ حياتِهم."
},
{
"i": 44,
"t0": 108.998,
"t1": 112.81,
"text": "إنّها من أطولِ الدراسات عن حياةِ البالغين على الإطلاق."
},
{
"i": 45,
"t0": 113.23,
"t1": 117.405,
"text": "أقوى مؤشّرٍ على حياةٍ طويلةٍ وصحّيّة لم يكن المال."
},
{
"i": 46,
"t0": 117.825,
"t1": 119.098,
"text": "ولم يكن الشهرة."
},
{
"i": 47,
"t0": 119.518,
"t1": 121.106,
"text": "بل العلاقاتُ القريبة."
},
{
"i": 48,
"t0": 122.056,
"t1": 123.665,
"text": "ثمّ يأتي يومُ الجمعة."
},
{
"i": 49,
"t0": 124.085,
"t1": 128.902,
"text": "صديقُك المقرّب علي يركضُ نحوك، يضحكُ على مقطعٍ ما."
},
{
"i": 50,
"t0": 129.322,
"t1": 130.364,
"text": "ترفعُ عينيك."
},
{
"i": 51,
"t0": 130.784,
"t1": 131.586,
"text": "رقمُ علي..."
},
{
"i": 52,
"t0": 132.186,
"t1": 133.371,
"text": "صفرُ سنوات."
},
{
"i": 53,
"t0": 133.791,
"t1": 134.859,
"text": "صفرُ أيّام."
},
{
"i": 54,
"t0": 135.279,
"t1": 136.203,
"text": "ساعتان."
},
{
"i": 55,
"t0": 137.203,
"t1": 138.26,
"text": "قلبُك يسقط."
},
{
"i": 56,
"t0": 139.16,
"t1": 139.982,
"text": "لا تخبره."
},
{
"i": 57,
"t0": 140.402,
"t1": 141.691,
"text": "كيف لك أن تخبره؟"
},
{
"i": 58,
"t0": 142.111,
"t1": 143.028,
"text": "تُلغي خططَه."
},
{
"i": 59,
"t0": 143.448,
"t1": 146.231,
"text": "تمشي معه إلى البيت من الطريقِ الأطول."
},
{
"i": 60,
"t0": 146.651,
"t1": 148.635,
"text": "يظنُّ أنّك فقدتَ عقلك."
},
{
"i": 61,
"t0": 149.585,
"t1": 151.187,
"text": "بقيت ستُّ دقائق."
},
{
"i": 62,
"t0": 151.607,
"t1": 152.684,
"text": "ممرُّ المشاة."
},
{
"i": 63,
"t0": 153.104,
"t1": 154.925,
"text": "الإشارةُ تصبحُ خضراء."
},
{
"i": 64,
"t0": 155.345,
"t1": 157.075,
"text": "يخطو علي إلى الأمام..."
},
{
"i": 65,
"t0": 157.675,
"t1": 159.106,
"text": "فتُمسِكُ بسترته."
},
{
"i": 66,
"t0": 159.526,
"t1": 162.124,
"text": "شاحنةٌ تتجاوزُ الإشارةَ الحمراء."
},
{
"i": 67,
"t0": 162.544,
"t1": 164.218,
"text": "على بُعدِ سنتيمترات."
},
{
"i": 68,
"t0": 165.118,
"t1": 165.542,
"text": "صمت."
},
{
"i": 69,
"t0": 166.642,
"t1": 167.684,
"text": "ترفعُ عينيك."
},
{
"i": 70,
"t0": 168.104,
"t1": 169.381,
"text": "رقمُ علي يدور..."
},
{
"i": 71,
"t0": 169.981,
"t1": 171.153,
"text": "ثمّ يتوقّف."
},
{
"i": 72,
"t0": 171.573,
"t1": 173.39,
"text": "واحدٌ وستّون عامًا."
},
{
"i": 73,
"t0": 174.29,
"t1": 175.406,
"text": "إنّه يرتجف."
},
{
"i": 74,
"t0": 175.826,
"t1": 176.592,
"text": "كيف عرفت؟"
},
{
"i": 75,
"t0": 177.012,
"t1": 177.893,
"text": "لا تُجيب."
},
{
"i": 76,
"t0": 178.313,
"t1": 179.456,
"text": "فقط تعانقُه."
},
{
"i": 77,
"t0": 180.406,
"t1": 185.08,
"text": "حوادثُ الطرق تقتلُ حوالي مليونٍ ومئتي ألفِ شخصٍ كلَّ عام."
},
{
"i": 78,
"t0": 185.5,
"t1": 187.534,
"text": "أكثرُ من اثنين كلَّ دقيقة."
},
{
"i": 79,
"t0": 187.954,
"t1": 194.552,
"text": "وهي السببُ الأوّلُ للوفاة بين من تتراوحُ أعمارُهم بين خمسةٍ وتسعةٍ وعشرين عامًا."
},
{
"i": 80,
"t0": 194.972,
"t1": 197.899,
"text": "إذن، الأرقامُ يمكنُ أن تتغيّر."
},
{
"i": 81,
"t0": 198.849,
"t1": 201.634,
"text": "في تلك الليلة، تقفُ أمامَ المرآة."
},
{
"i": 82,
"t0": 202.054,
"t1": 204.67,
"text": "لأوّلِ مرّة، تبحثُ عن رقمِك."
},
{
"i": 83,
"t0": 205.09,
"t1": 206.006,
"text": "فوقَ رأسِك..."
},
{
"i": 84,
"t0": 206.606,
"t1": 207.159,
"text": "لا شيء."
},
{
"i": 85,
"t0": 208.059,
"t1": 208.851,
"text": "لا رقم."
},
{
"i": 86,
"t0": 209.651,
"t1": 210.442,
"text": "أنت فقط."
},
{
"i": 87,
"t0": 210.862,
"t1": 212.065,
"text": "ترى وقتَ الجميع..."
},
{
"i": 88,
"t0": 212.665,
"t1": 213.598,
"text": "إلّا وقتَك."
},
{
"i": 89,
"t0": 214.018,
"t1": 215.983,
"text": "ربّما هذا هو المقصود."
},
{
"i": 90,
"t0": 216.403,
"t1": 217.907,
"text": "لا أحدَ يرى ساعتَه."
},
{
"i": 91,
"t0": 218.327,
"t1": 220.031,
"text": "فكلُّ ما يمكنُك فعلُه..."
},
{
"i": 92,
"t0": 220.631,
"t1": 221.648,
"text": "ألّا تُضيّعَه."
},
{
"i": 93,
"t0": 222.598,
"t1": 223.623,
"text": "تراسلُ أمَّك."
},
{
"i": 94,
"t0": 224.043,
"t1": 224.62,
"text": "أحبّك."
},
{
"i": 95,
"t0": 225.04,
"t1": 226.812,
"text": "تردُّ بثلاثةِ قلوب."
},
{
"i": 96,
"t0": 227.232,
"t1": 229.144,
"text": "واحدٌ وثلاثون عامًا."
},
{
"i": 97,
"t0": 229.564,
"t1": 231.927,
"text": "وتنوي أن تملأَ كلَّ واحدٍ منها."
},
{
"i": 98,
"t0": 232.877,
"t1": 234.592,
"text": "إذن، ما الحقيقي؟"
},
{
"i": 99,
"t0": 235.012,
"t1": 237.876,
"text": "لا أحدَ يستطيعُ رؤيةَ عدٍّ تنازلي."
},
{
"i": 100,
"t0": 238.296,
"t1": 242.062,
"text": "متوسّطُ العمر مجرّدُ معدّل، وليس وعدًا."
},
{
"i": 101,
"t0": 242.482,
"t1": 248.864,
"text": "ما يُقصّرُ معظمَ الأعمار بطيء: التدخين، والجلوسُ الطويل، والوحدة."
},
{
"i": 102,
"t0": 249.284,
"t1": 251.972,
"text": "وما يُطيلُها يكادُ يكونُ مملًّا..."
},
{
"i": 103,
"t0": 252.572,
"t1": 256.237,
"text": "النوم، والحركة، والناسُ الذين تحبّهم."
},
{
"i": 104,
"t0": 257.187,
"t1": 259.751,
"text": "ماذا ستفعلُ لو رأيتَ رقمَك أنت؟"
},
{
"i": 105,
"t0": 260.171,
"t1": 262.48,
"text": "وماذا لو استطعتَ إيقافَ الزمن؟"
},
{
"i": 106,
"t0": 262.9,
"t1": 268.514,
"text": "أخبرنا في التعليقات، وقل لنا أيَّ قوّةٍ نعيشُها في الحلقةِ القادمة."
},
{
"i": 107,
"t0": 268.934,
"t1": 271.821,
"text": "اضغط لايك، واشترك للمزيد."
}
]